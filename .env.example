# ==========================================
# CAMS BACKEND CONFIGURATION (.env)
# ==========================================

# Môi trường chạy (development / production)
ENVIRONMENT=development
PORT=8000

# Khóa bí mật dùng mã hóa JWT Token (thay đổi khi deploy)
SECRET_KEY=cams_secret_key_super_secure_2026_nhom6
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Kết nối Cơ sở dữ liệu (SQLite cho local / PostgreSQL cho Cloud)
DATABASE_URL=sqlite:///./cams.db

# Cấu hình CORS (Cho phép Frontend gọi API)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==========================================
# CAMS FRONTEND CONFIGURATION (.env)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000/api
